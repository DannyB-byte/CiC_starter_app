{
    "name": "vite-react-typescript-starter",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "lint": "eslint . --ignore-pattern \"coverage/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"test-results/**\" --ignore-pattern \"playwright-report/**\" --ignore-pattern \".qa-backups/**\" --max-warnings 0",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:report": "playwright show-report",
        "test:ui": "playwright test --ui",
        "dev:watchdog": "node scripts/dev-watchdog.mjs",
        "dev:app": "vite --host 127.0.0.1 --port 5173 --strictPort",
        "qa:check": "npm run lint && npm run typecheck && npm run build && npm run test:all",
        "test:all": "npm run test:unit && npm run test:e2e",
        "test:coverage": "vitest run --coverage",
        "test:unit": "vitest run",
        "test:mobile": "playwright test --project=mobile-chromium",
        "dev": "concurrently -k -n APP,QA \"npm run dev:app\" \"npm run dev:watchdog\"",
        "qa:audit": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/validate-repository.ps1",
        "test:production": "npm run build && playwright test --config=playwright.production.config.ts"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.57.4",
        "lucide-react": "^0.446.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.5",
        "recharts": "^3.10.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.1",
        "@eslint/js": "9.39.5",
        "@playwright/test": "^1.65.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.13",
        "@types/react": "^18.3.5",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^4.1.12",
        "autoprefixer": "^10.4.18",
        "chokidar": "^6.0.0",
        "concurrently": "^10.0.7",
        "eslint": "9.39.5",
        "eslint-plugin-react-hooks": "5.2.0",
        "eslint-plugin-react-refresh": "^0.4.11",
        "globals": "^15.9.0",
        "jsdom": "^29.1.1",
        "postcss": "^8.4.35",
        "tailwindcss": "3.4.19",
        "typescript": "^5.5.3",
        "typescript-eslint": "8.74.0",
        "vite": "^7.3.7",
        "vitest": "^4.1.12",
        "wait-on": "^9.5.1"
    }
}
